{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["**/__tests__/**", "**/*.spec.ts", "dist", "node_modules"]
}
