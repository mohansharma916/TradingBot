{
  "expo": {
    "name": "F&O Trading Workstation",
    "slug": "fo-trading-workstation",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "scheme": "fotrader",
    "splash": {
      "backgroundColor": "#090D16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fotrading.workstation"
    },
    "android": {
      "package": "com.fotrading.workstation"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
