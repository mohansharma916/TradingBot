# Multi-stage Dockerfile for Trader Universal Web Client
FROM node:24-alpine AS builder

WORKDIR /app

RUN npm install -g pnpm@10.13.1

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* tsconfig.base.json ./
COPY packages/ ./packages/
COPY apps/trader/ ./apps/trader/

RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @trading-bot/contracts build
RUN pnpm --filter @trading-bot/domain build
RUN pnpm --filter @trading-bot/ui build
RUN pnpm --filter @trading-bot/client-sdk build
RUN pnpm --filter @trading-bot/trader build:web

FROM nginx:alpine AS runner
COPY --from=builder /app/apps/trader/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
