# System Configuration
NODE_ENV=development
PORT=4000
WORKER_PORT=4001
API_HOST=127.0.0.1
STATE_DIRECTORY=.data
TRADING_API_URL=http://127.0.0.1:4000/api/v1
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Authentication (Owner Personal Access)
JWT_SECRET=super_secret_dev_key_change_in_production_min_32_chars
MFA_ENABLED=false
OWNER_USERNAME=owner
# Required before login: choose a private password with at least 12 characters.
# OWNER_PASSWORD=
# Replace JWT_SECRET above and set a private key below before connecting genuine Upstox credentials.
# TOKEN_ENCRYPTION_KEY=

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_bot
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trading_bot

# System Risk & Execution Invariants
# Navbar selection is persisted in STATE_DIRECTORY; fresh installations start Testing.
SYSTEM_MODE=PAPER
LIVE_EXECUTION_ENABLED=false
DEFAULT_RISK_STATE=DISARMED
MAX_ACCOUNT_CAPITAL_INR=10000
MAX_ALL_IN_TRADE_RISK_INR=500
MAX_DAILY_DRAWDOWN_INR=1500
TARGET_DAILY_PROFIT_INR=4000

# Daily Bot setups and session history (default: STATE_DIRECTORY/daily-bot.json)
# DAILY_BOT_STORAGE_PATH=/absolute/path/to/daily-bot.json

# Upstox Broker Integration (Server-Side Only - Never Exposed to Mobile/Web)
UPSTOX_API_KEY=mock_key
UPSTOX_API_SECRET=mock_client_secret
UPSTOX_REDIRECT_URI=http://localhost:4000/api/v1/broker/upstox/callback
UPSTOX_EGRESS_IP=127.0.0.1
UPSTOX_BASE_URL=https://api.upstox.com/v3
UPSTOX_HFT_URL=https://api-hft.upstox.com/v3
# Set only when applicable; must match your exchange-approved algo name configured in Upstox.
# UPSTOX_ALGO_NAME=

# Trader Client Configuration (Expo Universal App)
# Default: http://localhost:4000/api/v1 (set for production web client build)
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
