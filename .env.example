# System Configuration
NODE_ENV=development
PORT=4000
WORKER_PORT=4001
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Authentication (Owner Personal Access)
JWT_SECRET=super_secret_dev_key_change_in_production_min_32_chars
MFA_ENABLED=false

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_bot
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=trading_bot

# System Risk & Execution Invariants
SYSTEM_MODE=PAPER
DEFAULT_RISK_STATE=DISARMED
MAX_ACCOUNT_CAPITAL_INR=10000
MAX_ALL_IN_TRADE_RISK_INR=500
MAX_DAILY_DRAWDOWN_INR=1500
TARGET_DAILY_PROFIT_INR=4000

# Daily Bot setups and session history (default: repository .data/daily-bot.json)
# DAILY_BOT_STORAGE_PATH=/absolute/path/to/daily-bot.json

# Upstox Broker Integration (Server-Side Only - Never Exposed to Mobile/Web)
UPSTOX_API_KEY=mock_client_id
UPSTOX_API_SECRET=mock_client_secret
UPSTOX_REDIRECT_URI=http://localhost:4000/api/v1/broker/upstox/callback
UPSTOX_EGRESS_IP=127.0.0.1
UPSTOX_BASE_URL=https://api.upstox.com/v3
UPSTOX_HFT_URL=https://api-hft.upstox.com/v3
